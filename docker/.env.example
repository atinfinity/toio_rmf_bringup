# docker compose の設定例。使う場合はこのファイルを .env にコピーして編集する。
#   cp .env.example .env
# 詳細は docs/DASHBOARD.md を参照。

# --- ホストの ROS 2 環境と一致させること(ずれるとフリートが見えない) ---
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# --- 実機運用なら false(既定)、シミュレーションなら true ---
USE_SIM_TIME=false

# --- api-server ---
# 別マシンのブラウザから開く場合は 0.0.0.0 にし、PUBLIC_URL も実IPに合わせる
RMF_API_SERVER_HOST=127.0.0.1
RMF_API_SERVER_PUBLIC_URL=http://localhost:8000
RMF_API_SERVER_LOG_LEVEL=INFO
RMF_WEB_IMAGE_TAG=jazzy-nightly

# --- ダッシュボード ---
DASHBOARD_PORT=3000
# ズームは「1メートルあたりのピクセル数」(線形)。ビルド時に埋め込まれるため、
# 変更後は build し直すこと。空にすると main.tsx の既定値が使われる。
# A4 マット(0.297 x 0.210 m)を画面いっぱいに出すなら 2000 前後
DASHBOARD_ZOOM=
DASHBOARD_ROBOT_ZOOM=

# マーカーの実寸(m)。空にすると upstream の既定値(ロボット半径 0.7m、
# waypoint 一辺 0.65m、高さ 4m)が使われ、A4 マットでは床面図が覆い隠される。
# toio のキューブは 32mm 角なので 0.016 前後が実寸相当
DASHBOARD_ROBOT_RADIUS=
DASHBOARD_WAYPOINT_SIZE=
DASHBOARD_WAYPOINT_RADIUS=
DASHBOARD_MARKER_HEIGHT=
# ロボットのラベルの文字高(m)。upstream の 0.5 は 500mm でマットより大きい
DASHBOARD_LABEL_SIZE=

TZ=Asia/Tokyo
